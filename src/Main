import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.util.ArrayList;
import java.util.Random;

public class Main extends JPanel implements ActionListener {

    static final int CELL = 25;
    static final int COLS = 10;
    static final int ROWS = 10;
    static final int DELAY = 100; // ms per move

    private final ArrayList<Point> snake = new ArrayList<>();
    private final Random random = new Random();
    private final Timer timer = new Timer(DELAY, this);

    private Point food;
    private int dx, dy;          // current direction
    private int nextDx, nextDy;  // requested direction
    private int score;
    private int best;
    private boolean running;
    private boolean gameOver;

    public Main() {
        setPreferredSize(new Dimension(COLS * CELL, ROWS * CELL));
        setBackground(new Color(25, 25, 35));
        setFocusable(true);

        addKeyListener(new KeyAdapter() {
            @Override
            public void keyPressed(KeyEvent e) {
                switch (e.getKeyCode()) {
                    case KeyEvent.VK_LEFT, KeyEvent.VK_A -> {
                        if (dx != 1) { nextDx = -1; nextDy = 0; }
                    }
                    case KeyEvent.VK_RIGHT, KeyEvent.VK_D -> {
                        if (dx != -1) { nextDx = 1; nextDy = 0; }
                    }
                    case KeyEvent.VK_UP, KeyEvent.VK_W -> {
                        if (dy != 1) { nextDx = 0; nextDy = -1; }
                    }
                    case KeyEvent.VK_DOWN, KeyEvent.VK_S -> {
                        if (dy != -1) { nextDx = 0; nextDy = 1; }
                    }
                    case KeyEvent.VK_SPACE, KeyEvent.VK_ENTER -> {
                        if (!running) startGame();
                    }
                }
            }
        });

        showStartScreen();
    }

    private void showStartScreen() {
        running = false;
        gameOver = false;
        repaint();
    }

    private void startGame() {
        snake.clear();
        int startX = COLS / 2, startY = ROWS / 2;
        for (int i = 0; i < 3; i++) snake.add(new Point(startX - i, startY));
        dx = nextDx = 1;
        dy = nextDy = 0;
        score = 0;
        gameOver = false;
        running = true;
        spawnFood();
        timer.start();
        repaint();
    }

    private void spawnFood() {
        Point p;
        do {
            p = new Point(random.nextInt(COLS), random.nextInt(ROWS));
        } while (snake.contains(p));
        food = p;
    }

    @Override
    public void actionPerformed(ActionEvent e) {
        if (running) {
            move();
        }
        repaint();
    }

    private void move() {
        dx = nextDx;
        dy = nextDy;

        Point head = snake.get(0);
        Point newHead = new Point(head.x + dx, head.y + dy);

        // wall collision
        if (newHead.x < 0 || newHead.x >= COLS || newHead.y < 0 || newHead.y >= ROWS) {
            endGame();
            return;
        }
        // self collision
        if (snake.contains(newHead)) {
            endGame();
            return;
        }

        snake.add(0, newHead);

        if (newHead.equals(food)) {
            score++;
            best = Math.max(best, score);
            spawnFood();
        } else {
            snake.remove(snake.size() - 1);
        }
    }

    private void endGame() {
        running = false;
        gameOver = true;
        timer.stop();
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g;
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        // grid
        g2.setColor(new Color(35, 35, 48));
        for (int i = 0; i <= COLS; i++) g2.drawLine(i * CELL, 0, i * CELL, ROWS * CELL);
        for (int i = 0; i <= ROWS; i++) g2.drawLine(0, i * CELL, COLS * CELL, i * CELL);

        if (food != null) {
            g2.setColor(new Color(235, 70, 80));
            g2.fillOval(food.x * CELL + 3, food.y * CELL + 3, CELL - 6, CELL - 6);
        }

        for (int i = 0; i < snake.size(); i++) {
            Point p = snake.get(i);
            g2.setColor(i == 0 ? new Color(120, 230, 120) : new Color(60, 180, 90));
            g2.fillRoundRect(p.x * CELL + 1, p.y * CELL + 1, CELL - 2, CELL - 2, 8, 8);
        }

        // score
        g2.setColor(Color.WHITE);
        g2.setFont(new Font("SansSerif", Font.BOLD, 16));
        g2.drawString("Score: " + score + "   Best: " + best, 10, 22);

        if (!running) {
            String title = gameOver ? "Game Over" : "SNAKE";
            String hint = gameOver ? "Press SPACE to play again" : "Press SPACE to start  (Arrows / WASD to move)";
            drawCentered(g2, title, new Font("SansSerif", Font.BOLD, 48), getHeight() / 2 - 10);
            drawCentered(g2, hint, new Font("SansSerif", Font.PLAIN, 16), getHeight() / 2 + 25);
        }
    }

    private void drawCentered(Graphics2D g2, String text, Font font, int y) {
        g2.setFont(font);
        FontMetrics fm = g2.getFontMetrics();
        g2.setColor(Color.WHITE);
        g2.drawString(text, (getWidth() - fm.stringWidth(text)) / 2, y);
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            JFrame frame = new JFrame("Snake");
            frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
            frame.setResizable(false);
            frame.add(new Main());
            frame.pack();
            frame.setLocationRelativeTo(null);
            frame.setVisible(true);
        });
    }
}
